# sentient: kernel events for the coding agent's process tree.
{{.Comment}}# Generated by `sen policy`; install it with
#   sen policy | sudo tee /etc/tetragon/tetragon.tp.d/sentient.yaml
# and restart Tetragon (it does not reload a changed policy).
# Every hook is limited to the agent binaries below and what they start.
# Tetragon cannot follow children from a prefix match, so these are exact
# files: run `sen policy` again, and restart Tetragon, after the agent updates.
apiVersion: cilium.io/v1alpha1
kind: TracingPolicy
metadata:
  name: "sentient"
spec:
  kprobes:
  - call: "security_file_open"
    syscall: false
    args:
    - index: 0
      type: "file"
    selectors:
    - matchBinaries:
{{template "agents" .}}
      matchArgs:
      - index: 0
        operator: "FileType"
        values:
        - "reg"
{{- if .Essential}}
      - index: 0
        operator: "NotPrefix"
        values:
{{- range .Excluded}}
        - {{printf "%q" .}}
{{- end}}
    - matchBinaries:
{{template "agents" .}}
      matchArgs:
      - index: 0
        operator: "FileType"
        values:
        - "reg"
      - index: 0
        operator: "Prefix"
        values:
        - "/proc/"
      - index: 0
        operator: "NotPostfix"
        values:
        - "/stat"
        - "/statm"
{{- end}}
  - call: "security_path_mknod"
    syscall: false
    args:
    - index: 0
      type: "path"
    - index: 1
      type: "dentry"
    - index: 2
      type: "uint32"
    selectors:
    - matchBinaries:
{{template "agents" .}}
  - call: "security_path_unlink"
    syscall: false
    args:
    - index: 0
      type: "path"
    - index: 1
      type: "dentry"
    selectors:
    - matchBinaries:
{{template "agents" .}}
  - call: "security_path_mkdir"
    syscall: false
    args:
    - index: 0
      type: "path"
    - index: 1
      type: "dentry"
    selectors:
    - matchBinaries:
{{template "agents" .}}
  - call: "security_path_rmdir"
    syscall: false
    args:
    - index: 0
      type: "path"
    - index: 1
      type: "dentry"
    selectors:
    - matchBinaries:
{{template "agents" .}}
  - call: "security_path_rename"
    syscall: false
    args:
    - index: 0
      type: "path"
    - index: 1
      type: "dentry"
    - index: 2
      type: "path"
    - index: 3
      type: "dentry"
    selectors:
    - matchBinaries:
{{template "agents" .}}
  - call: "security_path_chmod"
    syscall: false
    args:
    - index: 0
      type: "path"
    - index: 1
      type: "uint32"
    selectors:
    - matchBinaries:
{{template "agents" .}}
  - call: "tcp_connect"
    syscall: false
    args:
    - index: 0
      type: "sock"
    selectors:
    - matchBinaries:
{{template "agents" .}}
  - call: "sys_kill"
    syscall: true
    args:
    - index: 0
      type: "int"
    - index: 1
      type: "int"
    selectors:
    - matchBinaries:
{{template "agents" .}}
  - call: "sys_tgkill"
    syscall: true
    args:
    - index: 0
      type: "int"
    - index: 1
      type: "int"
    - index: 2
      type: "int"
    selectors:
    - matchBinaries:
{{template "agents" .}}
{{- define "agents"}}      - operator: "In"
        values:
{{- range .Binaries}}
        - {{printf "%q" .}}
{{- end}}
        followChildren: true
{{- end}}
